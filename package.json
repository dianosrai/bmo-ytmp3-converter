{
  "name": "bmo-ytmp3-converter",
  "version": "1.0.0",
  "description": "A YouTube to MP3 app styled based on BMO the Adventure Time character",
  "author": "BMO YTMP3 Converter",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.15.8",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.bmo.ytmp3converter",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "favicon.ico"
    },
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**/*"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BMO YTMP3 Converter",
      "useZip": false
    },
    "directories": {
      "output": "dist"
    }
  }
}
